<!DOCTYPE html>
<html lang="{{lang}}" translate="no"{{if .Theme}} data-theme="{{.Theme}}"{{end}}{{if .ThemeMode}} data-theme-mode="{{.ThemeMode}}"{{end}}{{if .ThemeLight}} data-theme-light="{{.ThemeLight}}"{{end}}{{if .ThemeDark}} data-theme-dark="{{.ThemeDark}}"{{end}}>
<head>
    <meta charset="UTF-8">
    <meta name="google" content="notranslate">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{printf (tr "dataspace.title") .ClientName}}</title>
    <link rel="icon" type="image/svg+xml" href="{{.StaticPath}}/img/favicon.svg">
    <link rel="manifest" href="{{.StaticPath}}/img/manifest.webmanifest">
    <link rel="apple-touch-icon" href="{{.StaticPath}}/img/app-icon-192.png">
    <meta name="theme-color" content="#2563eb">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="RFID Dataspace">
    <!-- Automatic Skin & Dark / Light mode detection to prevent FOUC -->
    <script src="{{.StaticPath}}/js/theme-init.js"></script>
    <!-- Tailwind CSS, DaisyUI, HTMX 4 & SSE Extension (Relative Paths) -->
    <link rel="stylesheet" href="{{.StaticPath}}/css/tailwind.min.css">
    <link rel="stylesheet" href="{{.StaticPath}}/css/daisyui.min.css">
    <link rel="stylesheet" href="{{.StaticPath}}/css/daisyui-themes.min.css">
    <script src="{{.StaticPath}}/js/htmx-4.0.js"></script>
    <script src="{{.StaticPath}}/js/hx-sse.js"></script>
    <script src="{{.StaticPath}}/js/mermaid.min.js"></script>
    <link rel="stylesheet" href="{{.StaticPath}}/scss/dataspace.css">
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-primary selection:text-primary-content p-4 sm:p-6 lg:p-8" sse-connect="events" data-sse-connect="events" hx-ext="sse">

    {{template "header.gohtml" .}}

    <!-- Main Content Area -->
    <main class="w-full max-w-7xl mx-auto flex-1 flex flex-col gap-4">

        <!-- Active Media Table & Control Panel -->
        <section class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl overflow-hidden flex flex-col">
            <!-- Action Toolbar -->
            <div class="px-5 sm:px-6 py-3.5 sm:py-4 border-b border-base-200 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <div class="flex items-center space-x-2">
                        <h2 class="text-base font-semibold">{{tr "reader.items"}}</h2>
                        <span id="loan-tag-count-badge" class="badge badge-sm badge-outline font-mono">{{len .Tags}}</span>
                    </div>
                </div>
            </div>

            <!-- Status Notification Banner -->
            <div id="action-notification" class="hidden px-4 py-2 text-xs font-medium border-b border-base-200 transition-all flex items-center justify-between">
                <span id="action-notification-text"></span>
            </div>

            <!-- Active Tags Table with SSE Connection -->
            <div class="transponder-stream-scroll max-h-72 overflow-y-auto overflow-x-auto">
                <table class="table table-zebra table-pin-rows w-full text-left border-collapse">
                    <thead class="sticky top-0 z-10 bg-base-200 text-base-content/80 font-bold">
                        <tr class="text-[11px] font-semibold uppercase tracking-wider text-base-content/70">
                            <th scope="col" class="py-3 px-4 sm:px-5 whitespace-nowrap">{{tr "item.id"}}</th>
                            <th scope="col" class="py-3 px-4 sm:px-5 whitespace-nowrap">{{tr "tag.uid"}}</th>
                            <th scope="col" class="py-3 px-4 sm:px-5 whitespace-nowrap">{{tr "encode.parts"}}</th>
                            <th scope="col" class="py-3 px-4 sm:px-5 whitespace-nowrap">{{tr "library.isil"}}</th>
                            <th scope="col" class="py-3 px-4 sm:px-5 whitespace-nowrap">{{tr "tag.crc"}}</th>
                            <th scope="col" class="py-3 px-4 sm:px-5 text-right whitespace-nowrap">{{tr "inventory.scanTime"}}</th>
                        </tr>
                    </thead>
                    <tbody id="loan-table-body" sse-swap="loan_tags" data-sse-swap="loan_tags" hx-swap="innerHTML">
                        {{template "loan_table.gohtml" .}}
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Dataspace Knowledge Graph & Report Container (Tabbed View) -->
        <section id="dataspace-graph-section" class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl overflow-hidden flex flex-col min-h-[520px]">
            <!-- Action / Toolbar Header -->
            <div class="dataspace-graph-header px-5 sm:px-6 py-3.5 sm:py-4 border-b border-base-200 flex flex-wrap items-center justify-between gap-4 bg-base-100">
                <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                        <img id="dataspace-header-icon" src="{{.StaticPath}}/img/icons/chip.svg" class="w-5 h-5" alt="Dataspace" />
                    </div>
                    <div>
                        <!-- Tabs Header -->
                        <div class="flex items-center gap-2">
                            <div class="dataspace-tabs" role="tablist" aria-label="{{tr "dataspace.title"}}">
                                <button type="button" id="tab-btn-graph" role="tab" aria-selected="true" class="dataspace-tab-btn active tab-active">
                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="18" cy="5" r="3"></circle>
                                        <circle cx="6" cy="12" r="3"></circle>
                                        <circle cx="18" cy="19" r="3"></circle>
                                        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                                        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                                    </svg>
                                    <span>{{tr "dataspace.tabGraph"}}</span>
                                    <span id="graph-node-count-badge" class="dataspace-tab-badge hidden">0 Nodes</span>
                                </button>
                                <button type="button" id="tab-btn-report" role="tab" aria-selected="false" class="dataspace-tab-btn">
                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <polyline points="14 2 14 8 20 8"></polyline>
                                        <line x1="16" y1="13" x2="8" y2="13"></line>
                                        <line x1="16" y1="17" x2="8" y2="17"></line>
                                        <polyline points="10 9 9 9 8 9"></polyline>
                                    </svg>
                                    <span>{{tr "dataspace.tabReport"}}</span>
                                    <span id="report-item-count-badge" class="dataspace-tab-badge hidden">0</span>
                                </button>
                            </div>
                        </div>
                        <p id="dataspace-view-subtitle" class="text-xs text-base-content/70 mt-1">{{tr "dataspace.graphSubtitle"}}</p>
                    </div>
                </div>

                <!-- Graph Toolbar Controls -->
                <div id="graph-toolbar-controls" class="flex items-center gap-2 flex-wrap">
                    <!-- Orientation Toggle -->
                    <div class="join border border-base-300 rounded-lg p-0.5 bg-base-200/50">
                        <button type="button" id="graph-dir-td" class="btn btn-xs join-item btn-primary" title="{{tr "dataspace.dirTD"}}">TD ↓</button>
                        <button type="button" id="graph-dir-lr" class="btn btn-xs join-item btn-ghost" title="{{tr "dataspace.dirLR"}}">LR →</button>
                    </div>

                    <!-- Zoom Controls -->
                    <div class="join border border-base-300 rounded-lg p-0.5 bg-base-200/50">
                        <button type="button" id="graph-zoom-in" class="btn btn-xs join-item btn-ghost font-bold" title="{{tr "dataspace.zoomIn"}}">+</button>
                        <button type="button" id="graph-zoom-reset" class="btn btn-xs join-item btn-ghost text-[10px]" title="{{tr "dataspace.zoomReset"}}">100%</button>
                        <button type="button" id="graph-zoom-out" class="btn btn-xs join-item btn-ghost font-bold" title="{{tr "dataspace.zoomOut"}}">−</button>
                    </div>

                    <!-- Copy Mermaid Button -->
                    <button type="button" id="graph-copy-btn" class="btn btn-xs btn-outline gap-1" title="{{tr "dataspace.copyMermaidHint"}}" data-copied-text="{{tr "dataspace.copied"}}" data-copy-text="{{tr "dataspace.copyMermaid"}}" disabled>
                        <svg id="graph-copy-icon" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                        </svg>
                        <svg id="graph-copied-icon" class="w-3.5 h-3.5 hidden text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span id="graph-copy-text" class="hidden sm:inline">{{tr "dataspace.copyMermaid"}}</span>
                    </button>

                    <!-- Save SVG Button -->
                    <button type="button" id="graph-svg-btn" class="btn btn-xs btn-outline gap-1" title="{{tr "dataspace.saveSvgHint"}}" data-saved-text="{{tr "dataspace.savedSvg"}}" data-save-text="{{tr "dataspace.saveSvg"}}" disabled>
                        <svg id="graph-svg-icon" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        <svg id="graph-svg-saved-icon" class="w-3.5 h-3.5 hidden text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span id="graph-svg-text" class="hidden sm:inline">{{tr "dataspace.saveSvg"}}</span>
                    </button>

                    <!-- Fullscreen Toggle -->
                    <button type="button" id="graph-fullscreen-btn" class="btn btn-xs btn-outline gap-1" title="{{tr "dataspace.fullscreen"}}" data-expand-text="{{tr "dataspace.expand"}}" data-collapse-text="{{tr "dataspace.collapse"}}">
                        <svg id="graph-fullscreen-expand-icon" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
                        </svg>
                        <svg id="graph-fullscreen-collapse-icon" class="w-3.5 h-3.5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"/>
                        </svg>
                        <span id="graph-fullscreen-text" class="hidden sm:inline">{{tr "dataspace.expand"}}</span>
                    </button>

                    <!-- Refresh Button -->
                    <button type="button" id="graph-refresh-btn" class="btn btn-xs btn-ghost btn-square" title="{{tr "dataspace.refresh"}}">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.85.83 6.72 2.24L21 8"/><path d="M21 3v5h-5"/></svg>
                    </button>
                </div>

                <!-- Report Toolbar Controls -->
                <div id="report-toolbar-controls" class="hidden flex items-center gap-2 flex-wrap">
                    <!-- Print Button -->
                    <button type="button" id="report-print-btn" class="btn btn-xs btn-primary gap-1 shadow-xs" title="{{tr "dataspace.printReportHint"}}">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 6 2 18 2 18 9"></polyline>
                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                            <rect x="6" y="14" width="12" height="8"></rect>
                        </svg>
                        <span>{{tr "dataspace.printReport"}}</span>
                    </button>

                    <!-- Refresh Report Button -->
                    <button type="button" id="report-refresh-btn" class="btn btn-xs btn-ghost btn-square" title="{{tr "dataspace.refreshReport"}}">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.85.83 6.72 2.24L21 8"/><path d="M21 3v5h-5"/></svg>
                    </button>
                </div>
            </div>

            <!-- TAB PANE 1: Knowledge Graph -->
            <div id="dataspace-graph-pane" class="flex flex-col flex-1">
                <!-- Mermaid Graph Visualizer Container -->
                <div id="dataspace-graph-viewport" class="relative flex-1 w-full min-h-[460px] bg-base-200/30 overflow-hidden flex items-center justify-center p-4">
                    <!-- Loading Spinner State -->
                    <div id="dataspace-graph-loading" class="hidden absolute inset-0 bg-base-100/60 backdrop-blur-xs flex flex-col items-center justify-center z-20">
                        <span class="loading loading-spinner loading-lg text-primary"></span>
                        <span class="text-xs font-medium text-base-content/80 mt-2">{{tr "dataspace.loadingGraph"}}</span>
                    </div>

                    <!-- Empty State -->
                    <div id="dataspace-graph-empty" class="flex flex-col items-center justify-center text-center p-8 max-w-md mx-auto space-y-3">
                        <div class="w-16 h-16 rounded-2xl bg-base-200 flex items-center justify-center text-base-content/40">
                            <img src="{{.StaticPath}}/img/icons/empty-tags.svg" class="w-10 h-10 opacity-50" alt="Empty" />
                        </div>
                        <h3 class="font-semibold text-base text-base-content/90">{{tr "dataspace.emptyTitle"}}</h3>
                        <p class="text-xs text-base-content/60 leading-relaxed">{{tr "dataspace.emptyDescription"}}</p>
                    </div>

                    <!-- Rendered Mermaid SVG Container -->
                    <div id="dataspace-mermaid-output" class="w-full h-full flex items-center justify-center overflow-auto cursor-grab active:cursor-grabbing"></div>
                </div>

                <!-- Legend Footer Bar -->
                <div class="dataspace-graph-legend px-5 py-2.5 border-t border-base-200 bg-base-100/90 text-[11px] flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5 text-base-content/70 font-semibold mr-1">
                        <span>{{tr "dataspace.legend"}}:</span>
                    </div>
                    <div class="flex flex-wrap items-center gap-1.5">
                        <!-- RFID Tag: Stadium / Pill shape -->
                        <span class="dataspace-legend-item" title="{{tr "dataspace.legendTag"}}">
                            <svg class="w-3.5 h-2.5 shrink-0" viewBox="0 0 24 16" aria-hidden="true">
                                <rect x="1.5" y="1.5" width="21" height="13" rx="6.5" fill="#10b981" stroke="#047857" stroke-width="2.5"/>
                            </svg>
                            <span>{{tr "dataspace.legendTag"}}</span>
                        </span>

                        <!-- Alma Record: Rectangle -->
                        <span class="dataspace-legend-item" title="{{tr "dataspace.legendAlma"}}">
                            <svg class="w-3.5 h-2.5 shrink-0" viewBox="0 0 24 16" aria-hidden="true">
                                <rect x="1.5" y="1.5" width="21" height="13" rx="2" fill="#2563eb" stroke="#1d4ed8" stroke-width="2"/>
                            </svg>
                            <span>{{tr "dataspace.legendAlma"}}</span>
                        </span>

                        <!-- InK Repository: Rectangle -->
                        <span class="dataspace-legend-item" title="{{tr "dataspace.legendInk"}}">
                            <svg class="w-3.5 h-2.5 shrink-0" viewBox="0 0 24 16" aria-hidden="true">
                                <rect x="1.5" y="1.5" width="21" height="13" rx="2" fill="#db2777" stroke="#9d174d" stroke-width="2"/>
                            </svg>
                            <span>{{tr "dataspace.legendInk"}}</span>
                        </span>

                        <!-- OpenAlex Work: Rectangle -->
                        <span class="dataspace-legend-item" title="{{tr "dataspace.legendWork"}}">
                            <svg class="w-3.5 h-2.5 shrink-0" viewBox="0 0 24 16" aria-hidden="true">
                                <rect x="1.5" y="1.5" width="21" height="13" rx="2" fill="#4f46e5" stroke="#4338ca" stroke-width="2"/>
                            </svg>
                            <span>{{tr "dataspace.legendWork"}}</span>
                        </span>

                        <!-- Author: Hexagon -->
                        <span class="dataspace-legend-item" title="{{tr "dataspace.legendAuthor"}}">
                            <svg class="w-3.5 h-2.5 shrink-0" viewBox="0 0 24 16" aria-hidden="true">
                                <polygon points="5,1.5 19,1.5 23,8 19,14.5 5,14.5 1,8" fill="#d97706" stroke="#b45309" stroke-width="2" stroke-linejoin="round"/>
                            </svg>
                            <span>{{tr "dataspace.legendAuthor"}}</span>
                        </span>

                        <!-- Topic: Cylinder -->
                        <span class="dataspace-legend-item" title="{{tr "dataspace.legendTopic"}}">
                            <svg class="w-3.5 h-2.5 shrink-0" viewBox="0 0 24 16" aria-hidden="true">
                                <path d="M2 4.5 C2 2.5 6.5 1.5 12 1.5 C17.5 1.5 22 2.5 22 4.5 L22 11.5 C22 13.5 17.5 14.5 12 14.5 C6.5 14.5 2 13.5 2 11.5 Z" fill="#7c3aed" stroke="#6d28d9" stroke-width="2"/>
                                <ellipse cx="12" cy="4.5" rx="10" ry="2.8" fill="#7c3aed" stroke="#6d28d9" stroke-width="1.5"/>
                            </svg>
                            <span>{{tr "dataspace.legendTopic"}}</span>
                        </span>

                        <!-- Taxonomy / Field: Subroutine (Double Rect) -->
                        <span class="dataspace-legend-item" title="{{tr "dataspace.legendTaxonomy"}}">
                            <svg class="w-3.5 h-2.5 shrink-0" viewBox="0 0 24 16" aria-hidden="true">
                                <rect x="1.5" y="1.5" width="21" height="13" rx="1.5" fill="#0891b2" stroke="#0e7490" stroke-width="2"/>
                                <line x1="5.5" y1="1.5" x2="5.5" y2="14.5" stroke="#0e7490" stroke-width="1.5"/>
                                <line x1="18.5" y1="1.5" x2="18.5" y2="14.5" stroke="#0e7490" stroke-width="1.5"/>
                            </svg>
                            <span>{{tr "dataspace.legendTaxonomy"}}</span>
                        </span>

                        <!-- Institution / Library: Rectangle -->
                        <span class="dataspace-legend-item" title="{{tr "dataspace.legendInst"}}">
                            <svg class="w-3.5 h-2.5 shrink-0" viewBox="0 0 24 16" aria-hidden="true">
                                <rect x="1.5" y="1.5" width="21" height="13" rx="2" fill="#475569" stroke="#334155" stroke-width="2"/>
                            </svg>
                            <span>{{tr "dataspace.legendInst"}}</span>
                        </span>

                        <!-- Publisher / Source: Parallelogram -->
                        <span class="dataspace-legend-item" title="{{tr "dataspace.legendSource"}}">
                            <svg class="w-3.5 h-2.5 shrink-0" viewBox="0 0 24 16" aria-hidden="true">
                                <polygon points="5.5,1.5 22.5,1.5 18.5,14.5 1.5,14.5" fill="#0d9488" stroke="#0f766e" stroke-width="2" stroke-linejoin="round"/>
                            </svg>
                            <span>{{tr "dataspace.legendSource"}}</span>
                        </span>
                    </div>
                </div>
            </div>

            <!-- TAB PANE 2: Dossier / Report -->
            <div id="dataspace-report-pane" class="hidden flex flex-col flex-1 bg-base-100 overflow-y-auto min-h-[460px]">
                <!-- Loading State -->
                <div id="dataspace-report-loading" class="hidden py-16 flex flex-col items-center justify-center">
                    <span class="loading loading-spinner loading-lg text-primary"></span>
                    <span class="text-xs font-medium text-base-content/80 mt-2">{{tr "dataspace.loadingReport"}}</span>
                </div>

                <!-- Empty State -->
                <div id="dataspace-report-empty" class="flex flex-col items-center justify-center text-center p-8 max-w-md mx-auto space-y-3 my-auto">
                    <div class="w-16 h-16 rounded-2xl bg-base-200 flex items-center justify-center text-base-content/40">
                        <img src="{{.StaticPath}}/img/icons/empty-tags.svg" class="w-10 h-10 opacity-50" alt="Empty" />
                    </div>
                    <h3 class="font-semibold text-base text-base-content/90">{{tr "dataspace.reportEmptyTitle"}}</h3>
                    <p class="text-xs text-base-content/60 leading-relaxed">{{tr "dataspace.reportEmptyDescription"}}</p>
                </div>

                <!-- Rendered Report Content -->
                <div id="dataspace-report-output" class="hidden p-5 sm:p-6 lg:p-8 flex flex-col gap-6"></div>
            </div>
        </section>

    </main>

    {{template "footer.gohtml" .}}

    <!-- AFI Writing Modal Dialog / Waiting Overlay -->
    <dialog id="afi-modal-overlay" class="modal modal-bottom sm:modal-middle" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="afi-modal-title">
        <div class="modal-box text-center max-w-md bg-base-100 border border-base-200 shadow-xl">
            <div class="mx-auto mb-4 flex items-center justify-center">
                <span class="loading loading-spinner loading-lg text-primary"></span>
            </div>
            <h3 id="afi-modal-title" class="font-bold text-lg mb-2">{{tr "afi.writing"}}</h3>
            <p id="afi-modal-message" class="text-sm opacity-80 mb-4">
                {{tr "afi.waitHint"}}
            </p>
            <div class="flex items-center justify-center gap-2 mb-3">
                <span class="badge badge-info badge-outline gap-1 text-xs">
                    <span class="w-2 h-2 rounded-full bg-info animate-ping"></span>
                    <span id="afi-modal-status-text">{{tr "reader.communicationActive"}}</span>
                </span>
            </div>
            <div id="afi-modal-timeout-hint" class="text-xs opacity-60">
                {{tr "afi.timeoutProtection"}}
            </div>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

    <!-- Interactive script for audio, counters, copy-all and actions (Relative Path) -->
    <script type="module" src="{{.StaticPath}}/js/dataspace.js"></script>
</body>
</html>
